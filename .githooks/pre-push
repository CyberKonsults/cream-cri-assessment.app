#!/bin/sh
# Refuse pushes that still carry the GH007-blocked private author/committer.
blocked="tunjitaiwo@cyberkonsults.com"
noreply="66530516+iamtunji@users.noreply.github.com"
zero=0000000000000000000000000000000000000000

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    if git rev-parse --verify origin/main >/dev/null 2>&1; then
      range="origin/main..$local_sha"
    else
      range="$local_sha"
    fi
  else
    range="$remote_sha..$local_sha"
  fi

  if git log --format='%ae%n%ce' "$range" 2>/dev/null | grep -qxF "$blocked"; then
    echo "push blocked: unpushed commits use $blocked (GitHub GH007)."
    echo "rewrite them to $noreply, then push again."
    echo "example: GIT_AUTHOR_EMAIL=$noreply GIT_COMMITTER_EMAIL=$noreply git rebase origin/main --exec 'git commit --amend --no-edit --reset-author'"
    exit 1
  fi
done
